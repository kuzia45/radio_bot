BOT_TOKEN=1234567890:replace_with_token_from_BotFather

# Fill these in when the Spotify application is ready.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Railway sets PORT automatically. These paths should point to its mounted volume.
DATABASE_PATH=data/spotify.sqlite3
LOG_DIR=logs
BACKUP_DIR=data/backups

# Telegram ID of the owner who can run /admin_sources.
ADMIN_USER_ID=

# Source monitoring: alert after N failed checks or N minutes without a track change.
SOURCE_FAILURE_THRESHOLD=3
SOURCE_STALE_MINUTES=30
